<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Development Channel - Jaime Ros</title>

  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

  <style>

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #222;
      color: white;
      padding: 25px;
      text-align: center;
    }

    header h1 {
      margin: 0;
    }

    header p {
      margin-bottom: 0;
    }

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 25px;
    }

    .intro {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 8px;
    }

    .grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 20px;
    }

    .panel {
      background: white;
      padding: 20px;
      border-radius: 8px;
    }

    .control {
      margin-bottom: 20px;
    }

    .control label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
    }

    input[type="range"] {
      width: 100%;
    }

    .valor {
      font-weight: bold;
    }

    .results {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 20px;
      margin-bottom: 20px;
    }

    .card {
      background: white;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      border: 1px solid #ddd;
    }

    .card h3 {
      font-size: 14px;
      margin-top: 0;
    }

    .card .numero {
      font-size: 22px;
      font-weight: bold;
    }

    .equations {
      background: #eeeeee;
      padding: 15px;
      border-radius: 6px;
      line-height: 1.8;
    }

    .interpretacion {
      background: white;
      padding: 20px;
      margin-top: 20px;
      border-radius: 8px;
    }

    .nota {
      font-size: 13px;
      color: #555;
      line-height: 1.5;
    }

    footer {
      max-width: 1200px;
      margin: auto;
      padding: 25px;
      font-size: 14px;
    }

    @media(max-width: 800px) {

      .grid {
        grid-template-columns: 1fr;
      }

      .results {
        grid-template-columns: repeat(2, 1fr);
      }

    }

  </style>
</head>

<body>

<header>

  <h1>The Development Channel</h1>

  <p>
    Modelo interactivo basado en el capítulo 3 de Jaime Ros (2015)
  </p>

</header>


<div class="container">

  <div class="intro">

    <h2>Tipo de cambio real, salario real y crecimiento</h2>

    <p>
      Este modelo ilustra el mecanismo desarrollado por Jaime Ros
      en el capítulo 3 de <i>Development Macroeconomics in Latin
      America and Mexico</i>.
    </p>

    <p>
      En el modelo, una disminución inicial del salario real
      del sector transable aumenta su rentabilidad, eleva la
      acumulación de capital y favorece el crecimiento del empleo.
    </p>

  </div>


  <div class="grid">

    <!-- PANEL DE CONTROLES -->

    <div class="panel">

      <h2>Parámetros</h2>


      <div class="control">

        <label>
          Productividad A:
          <span id="Avalue" class="valor"></span>
        </label>

        <input
          type="range"
          id="A"
          min="0.5"
          max="2"
          step="0.05"
          value="1">

      </div>


      <div class="control">

        <label>
          Participación del capital α:
          <span id="alphaValue" class="valor"></span>
        </label>

        <input
          type="range"
          id="alpha"
          min="0.20"
          max="0.60"
          step="0.01"
          value="0.40">

      </div>


      <div class="control">

        <label>
          Salario real W/P:
          <span id="wageValue" class="valor"></span>
        </label>

        <input
          type="range"
          id="wage"
          min="0.40"
          max="1.20"
          step="0.01"
          value="0.80">

      </div>


      <div class="control">

        <label>
          Stock de capital K:
          <span id="Kvalue" class="valor"></span>
        </label>

        <input
          type="range"
          id="K"
          min="20"
          max="200"
          step="5"
          value="100">

      </div>


      <div class="control">

        <label>
          Propensión a invertir b:
          <span id="bValue" class="valor"></span>
        </label>

        <input
          type="range"
          id="b"
          min="0.05"
          max="0.80"
          step="0.01"
          value="0.25">

      </div>


      <div class="control">

        <label>
          Tasa internacional ajustada por riesgo r*:
          <span id="rstarValue" class="valor"></span>
        </label>

        <input
          type="range"
          id="rstar"
          min="0.01"
          max="0.20"
          step="0.01"
          value="0.08">

      </div>


      <div class="control">

        <label>
          Choque de devaluación: caída inicial de W/P:
          <span id="devValue" class="valor"></span>
        </label>

        <input
          type="range"
          id="devaluation"
          min="0"
          max="30"
          step="1"
          value="10">

      </div>


      <button
        onclick="resetModel()"
        style="padding:10px 20px; cursor:pointer;">
        Restablecer parámetros
      </button>

    </div>


    <!-- PANEL PRINCIPAL -->

    <div>

      <div class="panel">

        <h2>Ecuaciones del modelo</h2>

        <div class="equations">

          <div>
            <b>Producción:</b>
            Y = A K<sup>α</sup> L<sup>1−α</sup>
          </div>

          <div>
            <b>Demanda de trabajo:</b>
            L = [A(1−α)/(W/P)]<sup>1/α</sup>K
          </div>

          <div>
            <b>Tasa de ganancia:</b>
            r = α(P/P<sub>I</sub>)u
          </div>

          <div>
            <b>Acumulación:</b>
            g = b(r − r*)
          </div>

          <div>
            <b>Estado estacionario:</b>
            r = g/b + r*
          </div>

        </div>

        <p class="nota">
          Para la simulación se normaliza P/P<sub>I</sub> = 1.
          Esto permite concentrarnos en el mecanismo entre salario
          real, rentabilidad y acumulación.
        </p>

      </div>


      <div class="results">

        <div class="card">
          <h3>Empleo inicial</h3>
          <div id="L0" class="numero"></div>
        </div>

        <div class="card">
          <h3>Empleo después del choque</h3>
          <div id="L1" class="numero"></div>
        </div>

        <div class="card">
          <h3>Tasa de ganancia inicial</h3>
          <div id="r0" class="numero"></div>
        </div>

        <div class="card">
          <h3>Tasa de ganancia posterior</h3>
          <div id="r1" class="numero"></div>
        </div>

        <div class="card">
          <h3>Producción inicial</h3>
          <div id="Y0" class="numero"></div>
        </div>

        <div class="card">
          <h3>Producción posterior</h3>
          <div id="Y1" class="numero"></div>
        </div>

        <div class="card">
          <h3>Acumulación inicial</h3>
          <div id="g0" class="numero"></div>
        </div>

        <div class="card">
          <h3>Acumulación posterior</h3>
          <div id="g1" class="numero"></div>
        </div>

      </div>


      <div class="panel">

        <h2>Figura interactiva: tasa garantizada de crecimiento</h2>

        <p>
          Adaptación interactiva de la Figura 3.1 de Ros.
        </p>

        <div id="growthChart"></div>

      </div>


      <div class="panel" style="margin-top:20px;">

        <h2>Efecto del choque</h2>

        <div id="comparisonChart"></div>

      </div>

    </div>

  </div>


  <div class="interpretacion">

    <h2>Interpretación económica</h2>

    <p id="interpretation"></p>

    <p class="nota">
      El control denominado “choque de devaluación” representa
      de manera simplificada la caída inicial de W/P descrita por
      Ros. No supone que toda devaluación nominal se traduzca
      necesariamente en una reducción proporcional idéntica del
      salario real.
    </p>

  </div>

</div>


<footer>

  <hr>

  <p>
    <b>Fuente:</b> Ros, J. (2015).
    <i>Development Macroeconomics in Latin America and Mexico:
    Essays on Monetary, Exchange Rate, and Fiscal Policies.</i>
    Palgrave Macmillan, capítulo 3.
  </p>

</footer>


<script>

function value(id) {
  return parseFloat(document.getElementById(id).value);
}


function calculateModel() {

  const A = value("A");
  const alpha = value("alpha");
  const wage0 = value("wage");
  const K = value("K");
  const b = value("b");
  const rstar = value("rstar");
  const devaluation = value("devaluation");

  /*
  El choque representa una caída inicial del salario real
  después de una devaluación.
  */

  const wage1 =
    wage0 * (1 - devaluation / 100);


  /*
  Demanda de trabajo de Ros:
  L = [ A(1-alpha)/(W/P) ]^(1/alpha) K
  */

  const L0 =
    Math.pow(
      A * (1 - alpha) / wage0,
      1 / alpha
    ) * K;

  const L1 =
    Math.pow(
      A * (1 - alpha) / wage1,
      1 / alpha
    ) * K;


  /*
  Producción Cobb-Douglas
  */

  const Y0 =
    A *
    Math.pow(K, alpha) *
    Math.pow(L0, 1 - alpha);

  const Y1 =
    A *
    Math.pow(K, alpha) *
    Math.pow(L1, 1 - alpha);


  /*
  Output-capital ratio
  */

  const u0 = Y0 / K;
  const u1 = Y1 / K;


  /*
  Ros ecuación 3.2
  r = alpha (P/PI) u

  Normalizamos P/PI = 1
  */

  const r0 = alpha * u0;
  const r1 = alpha * u1;


  /*
  Ros ecuación 3.3
  g = b(r-r*)
  */

  const g0 = b * (r0 - rstar);
  const g1 = b * (r1 - rstar);


  updateValues(
    A, alpha, wage0, K,
    b, rstar, devaluation,
    L0, L1, Y0, Y1,
    r0, r1, g0, g1
  );


  drawGrowthChart(
    b,
    rstar,
    r0,
    r1,
    g0,
    g1
  );


  drawComparison(
    wage0,
    wage1,
    L0,
    L1,
    r0,
    r1,
    g0,
    g1
  );


  updateInterpretation(
    devaluation,
    wage0,
    wage1,
    r0,
    r1,
    g0,
    g1,
    L0,
    L1
  );

}


function updateValues(
  A, alpha, wage, K,
  b, rstar, dev,
  L0, L1,
  Y0, Y1,
  r0, r1,
  g0, g1
) {

  document.getElementById("Avalue").innerText =
    A.toFixed(2);

  document.getElementById("alphaValue").innerText =
    alpha.toFixed(2);

  document.getElementById("wageValue").innerText =
    wage.toFixed(2);

  document.getElementById("Kvalue").innerText =
    K.toFixed(0);

  document.getElementById("bValue").innerText =
    b.toFixed(2);

  document.getElementById("rstarValue").innerText =
    (rstar * 100).toFixed(1) + "%";

  document.getElementById("devValue").innerText =
    dev.toFixed(0) + "%";


  document.getElementById("L0").innerText =
    L0.toFixed(2);

  document.getElementById("L1").innerText =
    L1.toFixed(2);

  document.getElementById("Y0").innerText =
    Y0.toFixed(2);

  document.getElementById("Y1").innerText =
    Y1.toFixed(2);

  document.getElementById("r0").innerText =
    (r0 * 100).toFixed(2) + "%";

  document.getElementById("r1").innerText =
    (r1 * 100).toFixed(2) + "%";

  document.getElementById("g0").innerText =
    (g0 * 100).toFixed(2) + "%";

  document.getElementById("g1").innerText =
    (g1 * 100).toFixed(2) + "%";

}


function drawGrowthChart(
  b,
  rstar,
  r0,
  r1,
  g0,
  g1
) {

  let minimum =
    Math.min(-0.02, g0, g1);

  let maximum =
    Math.max(0.12, g0, g1) * 1.25;


  let gx = [];
  let expectedProfit = [];


  for (let i = 0; i <= 100; i++) {

    const g =
      minimum +
      (maximum - minimum) * i / 100;

    gx.push(g);

    expectedProfit.push(
      g / b + rstar
    );

  }


  const traceInvestment = {

    x: gx,
    y: expectedProfit,

    mode: "lines",

    name: "r = g/b + r*",

    line: {
      width: 3
    }

  };


  const traceInitial = {

    x: [minimum, maximum],
    y: [r0, r0],

    mode: "lines",

    name: "Ganancia inicial rA",

    line: {
      width: 3,
      dash: "dash"
    }

  };


  const traceAfter = {

    x: [minimum, maximum],
    y: [r1, r1],

    mode: "lines",

    name: "Ganancia después del choque rB",

    line: {
      width: 3
    }

  };


  const points = {

    x: [g0, g1],

    y: [r0, r1],

    mode: "markers+text",

    text: ["A", "B"],

    textposition: "top center",

    marker: {
      size: 12
    },

    name: "Equilibrios"

  };


  const layout = {

    xaxis: {
      title: "Tasa de acumulación (g)",
      tickformat: ".1%"
    },

    yaxis: {
      title: "Tasa de ganancia (r)",
      tickformat: ".1%"
    },

    legend: {
      orientation: "h"
    },

    margin: {
      t: 30
    }

  };


  Plotly.newPlot(
    "growthChart",
    [
      traceInvestment,
      traceInitial,
      traceAfter,
      points
    ],
    layout,
    {
      responsive: true
    }
  );

}


function drawComparison(
  wage0,
  wage1,
  L0,
  L1,
  r0,
  r1,
  g0,
  g1
) {

  const initial = {

    x: [
      "Salario real",
      "Empleo",
      "Ganancia",
      "Acumulación"
    ],

    y: [
      100,
      100,
      100,
      100
    ],

    name: "Situación inicial",

    type: "bar"

  };


  const after = {

    x: [
      "Salario real",
      "Empleo",
      "Ganancia",
      "Acumulación"
    ],

    y: [

      wage1 / wage0 * 100,

      L1 / L0 * 100,

      r1 / r0 * 100,

      g0 !== 0
        ? g1 / g0 * 100
        : 100

    ],

    name: "Después del choque",

    type: "bar"

  };


  const layout = {

    barmode: "group",

    yaxis: {
      title: "Índice: situación inicial = 100"
    },

    legend: {
      orientation: "h"
    },

    margin: {
      t: 30
    }

  };


  Plotly.newPlot(
    "comparisonChart",
    [initial, after],
    layout,
    {
      responsive: true
    }
  );

}


function updateInterpretation(
  dev,
  wage0,
  wage1,
  r0,
  r1,
  g0,
  g1,
  L0,
  L1
) {

  const profitChange =
    ((r1 / r0 - 1) * 100);

  const employmentChange =
    ((L1 / L0 - 1) * 100);


  let text = "";


  if (dev === 0) {

    text =
      "Sin un choque al salario real, la economía permanece " +
      "en el equilibrio inicial. Modifique el control de " +
      "devaluación para observar el mecanismo descrito por Ros.";

  }

  else {

    text =
      "El choque reduce inicialmente el salario real W/P de " +
      wage0.toFixed(2) +
      " a " +
      wage1.toFixed(2) +
      ". De acuerdo con el mecanismo del capítulo 3, la " +
      "reducción del salario-producto aumenta la rentabilidad " +
      "del sector transable. En esta simulación, la tasa de " +
      "ganancia pasa de " +
      (r0 * 100).toFixed(2) +
      "% a " +
      (r1 * 100).toFixed(2) +
      "% y la tasa de acumulación pasa de " +
      (g0 * 100).toFixed(2) +
      "% a " +
      (g1 * 100).toFixed(2) +
      "%. El empleo aumenta aproximadamente " +
      employmentChange.toFixed(2) +
      "%. En el diagrama (r,g), esto se observa como un " +
      "desplazamiento hacia arriba de la línea de rentabilidad " +
      "y el paso del equilibrio A al equilibrio B.";

  }


  document.getElementById(
    "interpretation"
  ).innerText = text;

}


function resetModel() {

  document.getElementById("A").value = 1;
  document.getElementById("alpha").value = 0.40;
  document.getElementById("wage").value = 0.80;
  document.getElementById("K").value = 100;
  document.getElementById("b").value = 0.25;
  document.getElementById("rstar").value = 0.08;
  document.getElementById("devaluation").value = 10;

  calculateModel();

}


document
  .querySelectorAll('input[type="range"]')
  .forEach(slider => {

    slider.addEventListener(
      "input",
      calculateModel
    );

  });


calculateModel();

</script>

</body>

</html>
